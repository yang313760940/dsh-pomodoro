{
  "name": "dsh-pomodoro",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 番茄闹钟插件：专注/短休/长休三阶段计时、结束提醒、今日与近 7 天统计，设置与统计落盘到 $DSH_HOME/pomodoro.json。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pomodoro",
    "番茄钟",
    "番茄闹钟",
    "productivity"
  ],
  "license": "MIT"
}
